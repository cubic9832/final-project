<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 7단계: 관리자 운영 현황. 재무 진단은 V1 input_snapshots · analysis_runs (회원이 결과 화면에서 저장한 기록) -->
<mapper namespace="com.kh.back.admin.mapper.AdminOverviewMapper">

    <select id="countProfileMissing" resultType="int">
        SELECT COUNT(*) FROM users u
        LEFT JOIN user_profiles p ON p.user_id = u.id
        WHERE p.birth_date IS NULL OR p.gender IS NULL
    </select>

    <!-- 진단 수는 회원의 기록만 (탈퇴하면 user_id 가 NULL 이 되어 빠진다) -->
    <sql id="memberDiagnoses">
        FROM analysis_runs a
        JOIN input_snapshots s ON s.snapshot_id = a.snapshot_id
        WHERE a.status_code = 'COMPLETED' AND s.user_id IS NOT NULL
    </sql>

    <select id="countDiagnoses" resultType="int">
        SELECT COUNT(*) <include refid="memberDiagnoses"/>
    </select>

    <select id="countDiagnosesSince" resultType="int">
        SELECT COUNT(*) <include refid="memberDiagnoses"/> AND a.completed_at &gt;= #{since}
    </select>

    <select id="countDiagnosedMembers" resultType="int">
        SELECT COUNT(DISTINCT s.user_id) <include refid="memberDiagnoses"/>
    </select>

    <select id="averageMonthlyAvailable" resultType="long">
        SELECT ROUND(AVG(a.monthly_available_amount)) <include refid="memberDiagnoses"/>
    </select>

    <select id="countDailyDiagnoses" resultType="com.kh.back.admin.dto.GroupCountRow">
        SELECT DATE_FORMAT(a.completed_at, '%Y-%m-%d') AS label, COUNT(*) AS count
        <include refid="memberDiagnoses"/> AND a.completed_at &gt;= #{since}
        GROUP BY label
    </select>
</mapper>
